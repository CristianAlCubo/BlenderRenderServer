NODE_ENV=production

# Fastify backend port (internal; not exposed publicly in production)
BACKEND_PORT=3000

# SQLite database file
DATABASE_URL=/data/database/app.db

# Redis connection for BullMQ
REDIS_URL=redis://redis:6379

# Persistent data root (database, projects, renders)
DATA_DIR=/data

# Blender and FFmpeg executables
BLENDER_PATH=/opt/blender/blender
FFMPEG_PATH=/usr/bin/ffmpeg

# Uploads
MAX_UPLOAD_SIZE=10GB

# Render worker
MAX_CONCURRENT_RENDERS=1
DEFAULT_RENDER_MODE=CPU
JOB_RETRY_ATTEMPTS=3

# Realtime
WS_PATH=/api/ws

# CORS (leave empty to disable in production; set to http://localhost:5173 for dev)
CORS_ORIGIN=
